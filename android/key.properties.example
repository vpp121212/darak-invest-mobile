# Copy to android/key.properties (git-ignored) and fill in your real values.
# Generate a keystore once with:
#   keytool -genkey -v -keystore darak-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias darak
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=darak
storeFile=darak-release.jks
