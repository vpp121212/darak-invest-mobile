{
  "expo": {
    "name": "دارك وحيك",
    "slug": "darak-wa-hayk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#020617",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darak.wahayk"
    },
    "android": {
      "package": "com.darak.wahayk",
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-web-browser",
        {
          "showsGoBackButton": true
        }
      ]
    ]
  }
}
